{
  "name": "@geed239/dsh-enhance-prompt",
  "version": "0.2.0",
  "description": "DSH 输入框提示词增强：把草稿改写成更清晰具体的指令",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "adcx222",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "prompt",
    "prompt-engineering",
    "prompt-enhance",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adcx222/dsh-enhance-prompt.git"
  },
  "homepage": "https://github.com/adcx222/dsh-enhance-prompt#readme",
  "bugs": {
    "url": "https://github.com/adcx222/dsh-enhance-prompt/issues"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "dshGo": {
    "v": 1,
    "minApp": "1.0.4",
    "title": {
      "zh": "提示词增强",
      "en": "Enhance prompt"
    },
    "icon": "sparkle",
    "wants": [
      "draft"
    ],
    "contributes": {
      "composer.actions": [
        {
          "id": "enhance",
          "label": {
            "zh": "增强提示词",
            "en": "Enhance"
          },
          "icon": "sparkle"
        }
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
